# 主机相关参数，host/ 下的脚本都从这里读。环境变量优先，例如 FRANKA_IFACE=eno1 bash host/check_host.sh
# 换一台主机时只改这个文件（和 config.yaml 里的 franka.ip、network.port）。

FRANKA_IFACE=${FRANKA_IFACE:-enp130s0}        # 接 FR3 Control 柜的网口（网线接 Control，不要接手臂底座）
FRANKA_IP=${FRANKA_IP:-192.168.3.1}           # Control 柜的 IP（Desk → Settings → Network 的 Shop Floor 地址）
HOST_CIDR=${HOST_CIDR:-192.168.3.100/24}      # 本机在 FRANKA_IFACE 上的静态地址，和 FRANKA_IP 同网段
FRANKA_CON=${FRANKA_CON:-franka_control}      # NetworkManager 连接名
VR_IFACE=${VR_IFACE:-}                        # 和头显在同一局域网的网卡；留空 = 自动找第一块无线网卡
VR_PORT=${VR_PORT:-47800}                     # 头显用的 UDP 端口，要和 config.yaml 的 network.port 一致

# 自动找无线网卡
if [ -z "$VR_IFACE" ]; then
  for d in /sys/class/net/*/wireless; do [ -e "$d" ] && { VR_IFACE=$(basename "$(dirname "$d")"); break; }; done
fi
